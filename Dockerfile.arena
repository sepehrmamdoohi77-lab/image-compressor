# Web release shape only; no native/Rork build is claimed.
FROM node:22-bookworm-slim AS client
WORKDIR /web
COPY tactical-arena/package*.json ./
RUN npm ci --no-audit --no-fund
COPY tactical-arena/ ./
RUN npm run build

FROM python:3.11-slim-bookworm AS server
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ARENA_AS_HOME=1 ARENA_DB_PATH=/data/arena.sqlite3 PORT=8000
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && mkdir -p /data
COPY main.py auth.py ./
COPY arena_server/ ./arena_server/
COPY static/ ./static/
COPY --from=client /web/dist/ ./tactical-arena/dist/
EXPOSE 8000
VOLUME ["/data"]
# A single writer is mandatory for live in-memory rooms; never add --workers 2+.
CMD ["sh", "-c", "exec uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --ws-max-size 4096"]
